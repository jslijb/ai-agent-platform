# Docker Compose 环境变量模板
# 本地开发：大部分使用默认值即可，仅需配置 MODEL_BASE_PATH
# 服务器部署：复制为 .env 并填写实际值

# 模型文件基础路径（本地 Windows / 服务器 Linux）
MODEL_BASE_PATH=D:\models\modelscope\models

# 模型文件名（本地用量化版，服务器用全量版）
EMBEDDING_MODEL_FILE=bge-m3-q8_0.gguf
RERANKER_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf

# PostgreSQL
PG_PORT=5432
PG_USER=aiagent
PG_PASSWORD=aiagent_secret
PG_DB=agentdb

# Redis
REDIS_PORT=6379

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234

# 服务端口
EMBEDDING_PORT=8011
EMBEDDING_THREADS=4
RERANKER_PORT=8010
RERANKER_THREADS=4
DATA_SERVICE_PORT=8001
MAIN_SERVICE_PORT=3000
RAG_SERVICE_PORT=3001
LLM_GATEWAY_PORT=3002
EVALUATION_SERVICE_PORT=3003
NGINX_PORT=80

# 监控
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# PaddleOCR（仅服务器）
PADDLEOCR_PORT=8020
PADDLEOCR_IMAGE=paddlepaddle/paddleocr:latest-gpu

# LLM API Key（阿里百炼 DashScope）
# 本地开发：已设为用户环境变量；服务器部署：在此填写实际值
DASHSCOPE_API_KEY=

# 认证
AUTH_SECRET=86a2f79587e77e111478fe872a01e89034e1bde9ca0c9da0f6ddf0069d9dadb1
AUTH_URL=http://localhost

# 微信小程序配置
WECHAT_APP_ID=
WECHAT_APP_SECRET=
