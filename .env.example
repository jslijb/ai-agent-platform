# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=your_admin_user
PG_ADMIN_PASSWORD=your_admin_password
PG_ADMIN_DB=your_admin_db
PG_USER=your_app_user
PG_PASSWORD=your_app_password
PG_DB=agentdb
DATABASE_URL=postgresql://your_app_user:your_app_password@localhost:5432/agentdb

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth v5
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# LLM API Key
# 说明：config/api_keys.yaml 中 llm.<字段> 的值填的是"环境变量名"，
#       运行时从本文件（挂载进容器的 .env.local）解析出真实 key。
# 主力：阿里百炼 DashScope（每个模型 1M token 额度，按序降级）
DASHSCOPE_API_KEY2=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 兜底：所有百炼模型额度耗尽后使用
AGNES_KEY=your-agnes-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
