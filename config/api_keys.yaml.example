# api_keys.yaml 配置示例
# 复制此文件为 api_keys.yaml 并填入实际值
# cp config/api_keys.yaml.example config/api_keys.yaml

llm:
  # 主力：阿里百炼（每个模型 1M token 额度）；兜底：AGNES agnes-3.0-flash（放列表最后）
  provider: dashscope  # 默认 provider，可选: dashscope, agnes
  AGNES_KEY: YOUR_ANNES_KEY
  AGNES_BASE_URL: https://api.agnes-ai.cn/v1
  DASHSCOPE_API_KEY: YOUR_DASHSCOPE_API_KEY
  DASHSCOPE_BASE_URL: https://dashscope.aliyuncs.com/compatible-mode/v1
  models:
    - id: qwen3.8-27b
      provider: dashscope
      functionCalling: true
    - id: qwen3.7-flash-2026-07-15
      provider: dashscope
      functionCalling: true
    - id: qwen3.8-flash
      provider: dashscope
      functionCalling: true
    - id: kimi-k3
      provider: dashscope
      functionCalling: true
    - id: deepseek-v4-flash-0731
      provider: dashscope
      functionCalling: true
    - id: qwen3.8-max-0902
      provider: dashscope
      functionCalling: true
    - id: deepseek-v4.1-flash
      provider: dashscope
      functionCalling: true
    - id: glm-5.3
      provider: dashscope
      functionCalling: true
    - id: deepseek-v4-pro-0813
      provider: dashscope
      functionCalling: true
    - id: qwen3.8-2.4t-a95b
      provider: dashscope
      functionCalling: true
    - id: agnes-3.0-flash  # 兜底模型
      provider: agnes
      functionCalling: true

vision:
  DASHSCOPE_API_KEY: YOUR_DASHSCOPE_API_KEY
  model: qwen-vl-plus
