.cache/

# Large generated eval/test artifacts
# 注: tests/reports/evaluation/ 自 2026-09-16 起入库——评估报告与数据集是
# 成绩的原始证据, 必须可追溯 (用户指定); 仅 tests/reports/test/ 仍本地保留
tests/reports/test/

# 本地跑测产生的报告（*.txt 已整体忽略，这里显式声明意图）
/test-reports/

# Accidental shell redirect artifacts
/1.0
/=

# npm lockfile 不使用（项目由 pnpm 管理，pnpm-lock.yaml 为唯一 lockfile）
package-lock.json

# 工具痕迹（CodeArts Doer 代码库索引, 含本地文件索引）
.codeartsdoer/

# 运行期临时产物（迁移备份/日志等），不入库
tmp/

# DB 备份文件（含用户数据，仅本地留存）
backups/
